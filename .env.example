# ---- Google (service account credential lives in n8n: "Google Service Account API",
#      scopes: spreadsheets, calendar.events, drive.readonly) ----
CALENDAR_ID=your_calendar_id@group.calendar.google.com
SHEET_ID=your_google_sheet_id

# ---- One-tap links ----
# Public URL of your n8n (e.g. the Cloudflare tunnel URL); links point to $BASE_URL/webhook/noshow
BASE_URL=https://your-n8n-public-url
# Long random string that signs the links (openssl rand -hex 24). Its first 12 characters are the
# key for the demo-seed and run-now links.
LINK_SECRET=change_me_long_random_secret

# ---- Messaging ----
# whatsapp = Twilio WhatsApp approved appointment-reminder template (works on the free trial)
# sms      = full text incl. the one-tap link (needs an SMS-capable Twilio number)
# outbox   = log only (to the sheet's Outbox tab)
CHANNEL=whatsapp
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM=+15550100100
# Content SID of the approved appointment-reminder template (variables {{1}} date, {{2}} time)
CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Demo data sends only to this opted-in test number (E.164)
TEST_PHONE=+15550100101
